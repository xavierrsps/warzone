# Warzone Manager — env (copy to .env, never commit)
# Admin password on FIRST boot (afterwards change it in the Settings page).
WARZONE_ADMIN_PASSWORD=changeme
# Optional: override the clan/site name on first boot (also editable in Settings).
# WARZONE_CLAN_NAME=The Squad
# JWT signing secret. If unset, a persistent random secret is generated in server/data/.secrets.json
# JWT_SECRET=
# Port (default 3003)
# PORT=3003
